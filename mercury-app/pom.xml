<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.mercury</groupId>
    <artifactId>mercury-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>mercury-app</artifactId>
  <name>Mercury :: Application</name>
  <description>
    Command-line entry point, terminal UI and the manual composition root that wires the
    engine together. Dependency injection here is hand-written on purpose: it proves the
    engine needs no framework, and makes the later Spring Boot module a pure addition
    rather than a rewrite.
  </description>

  <dependencies>
    <dependency>
      <groupId>com.mercury</groupId>
      <artifactId>mercury-engine</artifactId>
    </dependency>
    <!--
      The composition root gets its own architecture rules. The engine's cannot reach here:
      the dependency runs one way, so a check living in mercury-engine is blind to this module
      by construction - which is how a dead SimulationClock factory survived in DemoScenario.
    -->
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <!--
    One self-contained jar, so running any demo is `java -jar mercury-app/target/mercury.jar`
    rather than a hand-typed classpath whose separator differs between Windows and everything
    else. The engine has no runtime dependencies, so this is the two modules' classes and
    nothing more.
  -->
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <finalName>mercury</finalName>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>com.mercury.app.Main</mainClass>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

</project>
